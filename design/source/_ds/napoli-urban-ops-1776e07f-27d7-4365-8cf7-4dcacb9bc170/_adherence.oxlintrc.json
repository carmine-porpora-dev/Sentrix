{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/map/**",
              "components/navigation/**",
              "components/operations/**",
              "ui_kits/dashboard/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentTimelineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|duration|note|last|key|ref|className|style|children)$/]",
        "message": "<AgentTimelineItem> doesn't accept that prop. Declared props: name, status, duration, note, last."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentTimelineItem'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:waiting|running|done|fallback|error)$/]",
        "message": "<AgentTimelineItem> status must be one of 'waiting' | 'running' | 'done' | 'fallback' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: kind, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:real|estimate|simulated|unavailable|pending)$/]",
        "message": "<Badge> kind must be one of 'real' | 'estimate' | 'simulated' | 'unavailable' | 'pending'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|loading|loadingLabel|disabled|block|ariaLabel|type|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, icon, loading, loadingLabel, disabled, block, ariaLabel, type, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|stroke|ghost)$/]",
        "message": "<Button> variant must be one of 'solid' | 'stroke' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|clickable|onClick|className|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, clickable, onClick, className, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|nested)$/]",
        "message": "<Card> variant must be one of 'default' | 'nested'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionLogRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|actor|actorLabel|decision|reason|head|key|ref|className|style|children)$/]",
        "message": "<DecisionLogRow> doesn't accept that prop. Declared props: time, actor, actorLabel, decision, reason, head."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionLogRow'] > JSXAttribute[name.name='actor'] > Literal[value!=/^(?:system|agent|user|traffic|police|transport|comms)$/]",
        "message": "<DecisionLogRow> actor must be one of 'system' | 'agent' | 'user' | 'traffic' | 'police' | 'transport' | 'comms'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepartmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:dept|remaining|total|key|ref|className|style|children)$/]",
        "message": "<DepartmentCard> doesn't accept that prop. Declared props: dept, remaining, total."
      },
      {
        "selector": "JSXOpeningElement[name.name='DepartmentCard'] > JSXAttribute[name.name='dept'] > Literal[value!=/^(?:traffic|police|transport|comms)$/]",
        "message": "<DepartmentCard> dept must be one of 'traffic' | 'police' | 'transport' | 'comms'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EventManager'] > JSXAttribute > JSXIdentifier[name!=/^(?:attendance|onAttendanceChange|closures|stops|onRemoveClosure|onRemoveStop|onAnalyze|analyzing|key|ref|className|style|children)$/]",
        "message": "<EventManager> doesn't accept that prop. Declared props: attendance, onAttendanceChange, closures, stops, onRemoveClosure, onRemoveStop, onAnalyze, analyzing."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|stroke|spin|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, stroke, spin, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IterationIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:current|total|key|ref|className|style|children)$/]",
        "message": "<IterationIndicator> doesn't accept that prop. Declared props: current, total."
      },
      {
        "selector": "JSXOpeningElement[name.name='LayerPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:layers|onToggle|key|ref|className|style|children)$/]",
        "message": "<LayerPanel> doesn't accept that prop. Declared props: layers, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='ManualSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|key|ref|className|style|children)$/]",
        "message": "<ManualSwitch> doesn't accept that prop. Declared props: checked, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapMarker'] > JSXAttribute > JSXIdentifier[name!=/^(?:dept|state|key|ref|className|style|children)$/]",
        "message": "<MapMarker> doesn't accept that prop. Declared props: dept, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapMarker'] > JSXAttribute[name.name='dept'] > Literal[value!=/^(?:traffic|police|transport|comms)$/]",
        "message": "<MapMarker> dept must be one of 'traffic' | 'police' | 'transport' | 'comms'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapMarker'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:normal|accepted|rejected)$/]",
        "message": "<MapMarker> state must be one of 'normal' | 'accepted' | 'rejected'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:after|onAfterChange|iteration|onIterationChange|iterations|key|ref|className|style|children)$/]",
        "message": "<MapToggle> doesn't accept that prop. Declared props: after, onAfterChange, iteration, onIterationChange, iterations."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|delta|badge|loading|compact|key|ref|className|style|children)$/]",
        "message": "<MetricCard> doesn't accept that prop. Declared props: label, value, unit, delta, badge, loading, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricCard'] > JSXAttribute[name.name='badge'] > Literal[value!=/^(?:real|estimate|simulated|unavailable)$/]",
        "message": "<MetricCard> badge must be one of 'real' | 'estimate' | 'simulated' | 'unavailable'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|key|ref|className|style|children)$/]",
        "message": "<ModeSelector> doesn't accept that prop. Declared props: value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeSelector'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:live|scenario)$/]",
        "message": "<ModeSelector> value must be one of 'live' | 'scenario'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RequestCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:dept|code|status|measure|rejection|alternativeTo|key|ref|className|style|children)$/]",
        "message": "<RequestCard> doesn't accept that prop. Declared props: dept, code, status, measure, rejection, alternativeTo."
      },
      {
        "selector": "JSXOpeningElement[name.name='RequestCard'] > JSXAttribute[name.name='dept'] > Literal[value!=/^(?:traffic|police|transport|comms)$/]",
        "message": "<RequestCard> dept must be one of 'traffic' | 'police' | 'transport' | 'comms'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RequestCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:CREATED|SENT|RECEIVED|ACCEPTED|REJECTED|IN_PROGRESS|COMPLETED)$/]",
        "message": "<RequestCard> status must be one of 'CREATED' | 'SENT' | 'RECEIVED' | 'ACCEPTED' | 'REJECTED' | 'IN_PROGRESS' | 'COMPLETED'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunStatus'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|step|key|ref|className|style|children)$/]",
        "message": "<RunStatus> doesn't accept that prop. Declared props: state, step."
      },
      {
        "selector": "JSXOpeningElement[name.name='RunStatus'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:INTAKE|ANALYZE|RECONCILE|PLAN|DISPATCH|AWAIT|REPLAN|VERIFY|DONE|ERRORE|DECISIONE)$/]",
        "message": "<RunStatus> state must be one of 'INTAKE' | 'ANALYZE' | 'RECONCILE' | 'PLAN' | 'DISPATCH' | 'AWAIT' | 'REPLAN' | 'VERIFY' | 'DONE' | 'ERRORE' | 'DECISIONE'."
