      {
        "selector": "JSXOpeningElement[name.name='Sidebar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|brand|height|key|ref|className|style|children)$/]",
        "message": "<Sidebar> doesn't accept that prop. Declared props: items, active, onSelect, brand, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|active|onClick|key|ref|className|style|children)$/]",
        "message": "<SidebarButton> doesn't accept that prop. Declared props: icon, label, active, onClick."
